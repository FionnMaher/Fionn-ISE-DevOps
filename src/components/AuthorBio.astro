---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'authors'>['data'];

const { name, bio, avatar, socialLinks } = Astro.props;
---

<section class="author-bio" aria-labelledby="author-heading">
        <Image class="avatar" src={avatar} width={96} height={96} alt={`${name}'s avatar`} />
        <div>
                <h2 id="author-heading">About {name}</h2>
                <p>{bio}</p>
                <nav aria-label={`${name}'s social links`}>
                        {socialLinks.map(({ label, url }) => <a href={url} target="_blank" rel="noreferrer">{label}</a>)}
                </nav>
        </div>
</section>

<style>
        .author-bio {
                display: flex;
                gap: 1.25rem;
                align-items: flex-start;
                margin-top: 3rem;
                padding-top: 2rem;
                border-top: 1px solid rgb(var(--gray-light));
        }
        .avatar {
                flex: 0 0 96px;
                width: 96px;
                height: 96px;
                object-fit: cover;
                border-radius: 50%;
        }
        h2 {
                margin-bottom: 0.35rem;
                font-size: 1.25em;
        }
        p {
                margin: 0 0 0.5rem;
        }
        nav {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
        }
        nav a {
                font-size: 0.9em;
        }
        @media (max-width: 520px) {
                .author-bio {
                        gap: 1rem;
                }
                .avatar {
                        flex-basis: 72px;
                        width: 72px;
                        height: 72px;
                }
        }
</style>